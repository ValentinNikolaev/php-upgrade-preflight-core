{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:php-upgrade-preflight:schema:upgrade-report:0.5",
    "title": "PHP Upgrade Preflight v0.5 Report",
    "description": "Canonical machine-readable report produced by PHP Upgrade Preflight 0.1.x.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "metadata",
        "request_summary",
        "project_state",
        "resolution",
        "transition",
        "blockers",
        "source_impact",
        "framework_findings",
        "plan",
        "risk",
        "effort",
        "tests",
        "uncertainties",
        "evidence"
    ],
    "properties": {
        "metadata": {
            "$ref": "#/$defs/metadata"
        },
        "request_summary": {
            "$ref": "#/$defs/requestSummary"
        },
        "project_state": {
            "$ref": "#/$defs/projectState"
        },
        "resolution": {
            "$ref": "#/$defs/resolution"
        },
        "transition": {
            "$ref": "#/$defs/transition"
        },
        "blockers": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/blocker"
            }
        },
        "source_impact": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/sourceUsage"
            }
        },
        "framework_findings": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/frameworkFinding"
            }
        },
        "plan": {
            "$ref": "#/$defs/plan"
        },
        "risk": {
            "$ref": "#/$defs/risk"
        },
        "effort": {
            "$ref": "#/$defs/effort"
        },
        "tests": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/testGuidance"
            }
        },
        "uncertainties": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            },
            "uniqueItems": true
        },
        "evidence": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/evidence"
            }
        }
    },
    "$defs": {
        "metadata": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema_version",
                "tool"
            ],
            "properties": {
                "schema_version": {
                    "const": "0.5"
                },
                "tool": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "name",
                        "version"
                    ],
                    "properties": {
                        "name": {
                            "const": "php-upgrade-preflight"
                        },
                        "version": {
                            "type": "string",
                            "pattern": "^0\\.1\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
                        }
                    }
                }
            }
        },
        "requestSummary": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "project_path",
                "targets",
                "from_php",
                "target_php",
                "source_paths",
                "frameworks",
                "format",
                "output_path"
            ],
            "properties": {
                "project_path": {
                    "type": "string",
                    "minLength": 1
                },
                "targets": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/target"
                    }
                },
                "from_php": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "target_php": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "source_paths": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "frameworks": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    },
                    "uniqueItems": true
                },
                "format": {
                    "enum": [
                        "json",
                        "markdown"
                    ]
                },
                "output_path": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        },
        "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "package",
                "constraint"
            ],
            "properties": {
                "package": {
                    "type": "string",
                    "minLength": 1
                },
                "constraint": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "projectState": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "path",
                "platform_php",
                "root_requirements",
                "locked_packages"
            ],
            "properties": {
                "path": {
                    "type": "string",
                    "minLength": 1
                },
                "platform_php": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "root_requirements": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "locked_packages": {
                    "type": "integer",
                    "minimum": 0
                }
            }
        },
        "resolution": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "status",
                "scenarios"
            ],
            "properties": {
                "status": {
                    "enum": [
                        "feasible",
                        "feasible_with_changes",
                        "blocked",
                        "unknown"
                    ]
                },
                "scenarios": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/scenario"
                    }
                }
            }
        },
        "scenario": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "composer_version",
                "command",
                "duration_ms",
                "exit_code",
                "succeeded",
                "outcome",
                "failure_type",
                "stdout_excerpt",
                "stderr_excerpt",
                "candidate_lock",
                "diagnostics",
                "temp_path"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "composer_version": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "minLength": 1
                },
                "command": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "duration_ms": {
                    "type": "integer",
                    "minimum": 0
                },
                "exit_code": {
                    "type": "integer"
                },
                "succeeded": {
                    "type": "boolean"
                },
                "outcome": {
                    "enum": [
                        "success",
                        "solver_failure",
                        "validation_failure",
                        "composer_missing",
                        "timeout",
                        "invalid_json",
                        "lockfile_missing",
                        "process_failure",
                        "cleanup_failure",
                        "workspace_failure"
                    ]
                },
                "failure_type": {
                    "enum": [
                        "solver",
                        "operational",
                        "validation",
                        null
                    ]
                },
                "stdout_excerpt": {
                    "type": "string",
                    "maxLength": 4000
                },
                "stderr_excerpt": {
                    "type": "string",
                    "maxLength": 4000
                },
                "candidate_lock": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/candidateLock"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "diagnostics": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/composerDiagnostic"
                    }
                },
                "temp_path": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        },
        "composerDiagnostic": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "package",
                "constraint",
                "command",
                "exit_code",
                "stdout_excerpt",
                "stderr_excerpt"
            ],
            "properties": {
                "package": {
                    "type": "string",
                    "minLength": 1
                },
                "constraint": {
                    "type": "string",
                    "minLength": 1
                },
                "command": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "exit_code": {
                    "type": "integer"
                },
                "stdout_excerpt": {
                    "type": "string",
                    "maxLength": 4000
                },
                "stderr_excerpt": {
                    "type": "string",
                    "maxLength": 4000
                }
            }
        },
        "candidateLock": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "sha256",
                "content_hash",
                "package_count"
            ],
            "properties": {
                "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                },
                "content_hash": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "package_count": {
                    "type": "integer",
                    "minimum": 0
                }
            }
        },
        "transition": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "package_changes",
                "root_constraint_changes"
            ],
            "properties": {
                "package_changes": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/packageChange"
                    }
                },
                "root_constraint_changes": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/rootConstraintChange"
                    }
                }
            }
        },
        "packageChange": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "change_type",
                "from_version",
                "to_version",
                "direct",
                "major_change",
                "package_families",
                "from_source_reference",
                "to_source_reference",
                "from_dist_reference",
                "to_dist_reference"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "change_type": {
                    "enum": [
                        "added",
                        "removed",
                        "upgraded",
                        "downgraded",
                        "changed"
                    ]
                },
                "from_version": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "to_version": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "direct": {
                    "type": "boolean"
                },
                "major_change": {
                    "type": "boolean"
                },
                "package_families": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    },
                    "uniqueItems": true
                },
                "from_source_reference": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "to_source_reference": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "from_dist_reference": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "to_dist_reference": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        },
        "rootConstraintChange": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "package",
                "change_type",
                "from_constraint",
                "to_constraint",
                "reason",
                "evidence"
            ],
            "properties": {
                "package": {
                    "type": "string",
                    "minLength": 1
                },
                "change_type": {
                    "enum": [
                        "added",
                        "updated",
                        "removed"
                    ]
                },
                "from_constraint": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "to_constraint": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "reason": {
                    "type": "string",
                    "minLength": 1
                },
                "evidence": {
                    "$ref": "#/$defs/evidenceReferences"
                }
            }
        },
        "blocker": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "subject",
                "summary",
                "confidence",
                "evidence"
            ],
            "properties": {
                "type": {
                    "type": "string",
                    "minLength": 1
                },
                "subject": {
                    "type": "string",
                    "minLength": 1
                },
                "summary": {
                    "type": "string",
                    "minLength": 1
                },
                "confidence": {
                    "$ref": "#/$defs/confidence"
                },
                "evidence": {
                    "$ref": "#/$defs/evidenceReferences"
                }
            }
        },
        "sourceUsage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "file",
                "symbol",
                "usage_type",
                "line",
                "evidence"
            ],
            "properties": {
                "file": {
                    "type": "string",
                    "minLength": 1
                },
                "symbol": {
                    "type": "string",
                    "minLength": 1
                },
                "usage_type": {
                    "type": "string",
                    "minLength": 1
                },
                "line": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "minimum": 1
                },
                "evidence": {
                    "$ref": "#/$defs/evidenceReferences"
                }
            }
        },
        "frameworkFinding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "framework",
                "severity",
                "summary",
                "evidence"
            ],
            "properties": {
                "framework": {
                    "type": "string",
                    "minLength": 1
                },
                "severity": {
                    "enum": [
                        "low",
                        "medium",
                        "high"
                    ]
                },
                "summary": {
                    "type": "string",
                    "minLength": 1
                },
                "evidence": {
                    "$ref": "#/$defs/evidenceReferences"
                }
            }
        },
        "plan": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "stages"
            ],
            "properties": {
                "stages": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/planStage"
                    }
                }
            }
        },
        "planStage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "summary",
                "actions",
                "evidence"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "summary": {
                    "type": "string",
                    "minLength": 1
                },
                "actions": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "evidence": {
                    "$ref": "#/$defs/evidenceReferences"
                }
            }
        },
        "risk": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "level",
                "drivers"
            ],
            "properties": {
                "level": {
                    "enum": [
                        "low",
                        "medium",
                        "high"
                    ]
                },
                "drivers": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        },
        "effort": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "range_hours",
                "confidence",
                "components",
                "assumptions"
            ],
            "properties": {
                "range_hours": {
                    "$ref": "#/$defs/hourRange"
                },
                "confidence": {
                    "$ref": "#/$defs/confidence"
                },
                "components": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/hourRange"
                    }
                },
                "assumptions": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        },
        "hourRange": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
                {
                    "type": "integer",
                    "minimum": 0
                },
                {
                    "type": "integer",
                    "minimum": 0
                }
            ],
            "items": false
        },
        "testGuidance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "purpose",
                "command",
                "priority"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "purpose": {
                    "type": "string",
                    "minLength": 1
                },
                "command": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "priority": {
                    "enum": [
                        "required",
                        "recommended"
                    ]
                }
            }
        },
        "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "class",
                "summary",
                "confidence",
                "context"
            ],
            "properties": {
                "id": {
                    "$ref": "#/$defs/evidenceId"
                },
                "class": {
                    "enum": [
                        "E1",
                        "E2",
                        "E3",
                        "E4",
                        "E5"
                    ]
                },
                "summary": {
                    "type": "string",
                    "minLength": 1
                },
                "confidence": {
                    "$ref": "#/$defs/confidence"
                },
                "context": {
                    "type": "object"
                }
            }
        },
        "evidenceReferences": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "$ref": "#/$defs/evidenceId"
            }
        },
        "evidenceId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "confidence": {
            "enum": [
                "low",
                "medium",
                "high"
            ]
        }
    }
}
