{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:php-upgrade-preflight:schema:upgrade-report:0.7",
    "title": "PHP Upgrade Preflight v0.7 Report",
    "description": "Canonical machine-readable report produced by PHP Upgrade Preflight 0.2.x.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "metadata",
        "request_summary",
        "project_state",
        "platform",
        "resolution",
        "transition",
        "blockers",
        "source_inventory",
        "source_impact",
        "framework_findings",
        "plan",
        "risk",
        "effort",
        "tests",
        "uncertainties",
        "evidence"
    ],
    "properties": {
        "metadata": {
            "$ref": "#/$defs/metadata"
        },
        "request_summary": {
            "$ref": "#/$defs/requestSummary"
        },
        "project_state": {
            "$ref": "#/$defs/projectState"
        },
        "platform": {
            "$ref": "#/$defs/platformProvenance"
        },
        "resolution": {
            "$ref": "#/$defs/resolution"
        },
        "transition": {
            "$ref": "#/$defs/transition"
        },
        "blockers": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/blocker"
            }
        },
        "source_inventory": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/sourceUsage"
            }
        },
        "source_impact": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/sourceImpactFinding"
            }
        },
        "framework_findings": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/frameworkFinding"
            }
        },
        "plan": {
            "$ref": "#/$defs/plan"
        },
        "risk": {
            "$ref": "#/$defs/risk"
        },
        "effort": {
            "$ref": "#/$defs/effort"
        },
        "tests": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/testGuidance"
            }
        },
        "uncertainties": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            },
            "uniqueItems": true
        },
        "evidence": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/evidence"
            }
        }
    },
    "$defs": {
        "metadata": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema_version",
                "tool"
            ],
            "properties": {
                "schema_version": {
                    "const": "0.7"
                },
                "tool": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "name",
                        "version"
                    ],
                    "properties": {
                        "name": {
                            "const": "php-upgrade-preflight"
                        },
                        "version": {
                            "type": "string",
                            "pattern": "^0\\.2\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
                        }
                    },
                    "allOf": [
                        {
                            "if": {
                                "properties": {
                                    "completeness": {
                                        "const": "none"
                                    }
                                }
                            },
                            "then": {
                                "properties": {
                                    "provenance": {
                                        "const": "analyzer_runtime"
                                    },
                                    "explicitly_modeled": {
                                        "const": false
                                    },
                                    "unmodeled_provenance": {
                                        "const": "analyzer_runtime"
                                    },
                                    "assumptions": {
                                        "maxItems": 0
                                    }
                                }
                            }
                        },
                        {
                            "if": {
                                "properties": {
                                    "completeness": {
                                        "const": "partial"
                                    }
                                }
                            },
                            "then": {
                                "properties": {
                                    "provenance": {
                                        "const": "mixed"
                                    },
                                    "explicitly_modeled": {
                                        "const": true
                                    },
                                    "unmodeled_provenance": {
                                        "const": "analyzer_runtime"
                                    },
                                    "assumptions": {
                                        "minItems": 1
                                    }
                                }
                            }
                        },
                        {
                            "if": {
                                "properties": {
                                    "completeness": {
                                        "const": "complete"
                                    }
                                }
                            },
                            "then": {
                                "properties": {
                                    "explicitly_modeled": {
                                        "const": true
                                    },
                                    "unmodeled_provenance": {
                                        "type": "null"
                                    },
                                    "assumptions": {
                                        "minItems": 1
                                    }
                                }
                            }
                        }
                    ]
                }
            }
        },
        "requestSummary": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "project_path",
                "targets",
                "from_php",
                "target_php",
                "source_paths",
                "frameworks",
                "format",
                "output_path"
            ],
            "properties": {
                "project_path": {
                    "type": "string",
                    "minLength": 1
                },
                "targets": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/target"
                    }
                },
                "from_php": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "target_php": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "source_paths": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "frameworks": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    },
                    "uniqueItems": true
                },
                "format": {
                    "enum": [
                        "json",
                        "markdown"
                    ]
                },
                "output_path": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        },
        "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "package",
                "constraint"
            ],
            "properties": {
                "package": {
                    "type": "string",
                    "minLength": 1
                },
                "constraint": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "projectState": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "path",
                "platform_php",
                "root_requirements",
                "locked_packages"
            ],
            "properties": {
                "path": {
                    "type": "string",
                    "minLength": 1
                },
                "platform_php": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "root_requirements": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "locked_packages": {
                    "type": "integer",
                    "minimum": 0
                }
            }
        },
        "platformProvenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "analyzer",
                "current_php",
                "target_php",
                "extensions"
            ],
            "properties": {
                "analyzer": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "php_version",
                        "provenance"
                    ],
                    "properties": {
                        "php_version": {
                            "type": "string",
                            "minLength": 1
                        },
                        "provenance": {
                            "const": "runtime"
                        }
                    }
                },
                "current_php": {
                    "$ref": "#/$defs/phpProvenance"
                },
                "target_php": {
                    "$ref": "#/$defs/phpProvenance"
                },
                "extensions": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "provenance",
                        "explicitly_modeled",
                        "completeness",
                        "unmodeled_provenance",
                        "assumptions"
                    ],
                    "properties": {
                        "provenance": {
                            "enum": [
                                "analyzer_runtime",
                                "composer_config",
                                "request",
                                "mixed"
                            ]
                        },
                        "explicitly_modeled": {
                            "type": "boolean"
                        },
                        "completeness": {
                            "enum": [
                                "none",
                                "partial",
                                "complete"
                            ]
                        },
                        "unmodeled_provenance": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "enum": [
                                "analyzer_runtime",
                                null
                            ]
                        },
                        "assumptions": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/extensionAssumption"
                            }
                        }
                    }
                }
            }
        },
        "phpProvenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "version",
                "provenance"
            ],
            "properties": {
                "version": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "provenance": {
                    "enum": [
                        "request",
                        "composer_config",
                        "unknown"
                    ]
                }
            }
        },
        "extensionAssumption": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "state",
                "version",
                "provenance"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "pattern": "^ext-[a-z0-9_.-]+$"
                },
                "state": {
                    "enum": [
                        "present",
                        "absent"
                    ]
                },
                "version": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "provenance": {
                    "enum": [
                        "request",
                        "composer_config"
                    ]
                }
            }
        },
        "resolution": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "status",
                "scenarios"
            ],
            "properties": {
                "status": {
                    "enum": [
                        "feasible",
                        "feasible_with_changes",
                        "blocked",
                        "unknown"
                    ]
                },
                "scenarios": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/scenario"
                    }
                }
            }
        },
        "scenario": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "composer_version",
                "command",
                "duration_ms",
                "exit_code",
                "succeeded",
                "outcome",
                "failure_type",
                "stdout_excerpt",
                "stderr_excerpt",
                "candidate_lock",
                "diagnostics",
                "temp_path"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "composer_version": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "minLength": 1
                },
                "command": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "duration_ms": {
                    "type": "integer",
                    "minimum": 0
                },
                "exit_code": {
                    "type": "integer"
                },
                "succeeded": {
                    "type": "boolean"
                },
                "outcome": {
                    "enum": [
                        "success",
                        "solver_failure",
                        "validation_failure",
                        "composer_missing",
                        "timeout",
                        "invalid_json",
                        "lockfile_missing",
                        "process_failure",
                        "cleanup_failure",
                        "workspace_failure"
                    ]
                },
                "failure_type": {
                    "enum": [
                        "solver",
                        "operational",
                        "validation",
                        null
                    ]
                },
                "stdout_excerpt": {
                    "type": "string",
                    "maxLength": 4000
                },
                "stderr_excerpt": {
                    "type": "string",
                    "maxLength": 4000
                },
                "candidate_lock": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/candidateLock"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "diagnostics": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/composerDiagnostic"
                    }
                },
                "temp_path": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        },
        "composerDiagnostic": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "package",
                "constraint",
                "command",
                "exit_code",
                "stdout_excerpt",
                "stderr_excerpt"
            ],
            "properties": {
                "package": {
                    "type": "string",
                    "minLength": 1
                },
                "constraint": {
                    "type": "string",
                    "minLength": 1
                },
                "command": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "exit_code": {
                    "type": "integer"
                },
                "stdout_excerpt": {
                    "type": "string",
                    "maxLength": 4000
                },
                "stderr_excerpt": {
                    "type": "string",
                    "maxLength": 4000
                }
            }
        },
        "candidateLock": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "sha256",
                "content_hash",
                "package_count"
            ],
            "properties": {
                "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                },
                "content_hash": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "package_count": {
                    "type": "integer",
                    "minimum": 0
                }
            }
        },
        "transition": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "package_changes",
                "root_constraint_changes",
                "framework_guidance"
            ],
            "properties": {
                "package_changes": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/packageChange"
                    }
                },
                "root_constraint_changes": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/rootConstraintChange"
                    }
                },
                "framework_guidance": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/frameworkGuidance"
                    }
                }
            }
        },
        "frameworkGuidance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "framework",
                "source_major",
                "target_major",
                "status",
                "hops",
                "uncertainties",
                "evidence"
            ],
            "properties": {
                "framework": {
                    "type": "string",
                    "minLength": 1
                },
                "source_major": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "minimum": 0
                },
                "target_major": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "minimum": 0
                },
                "status": {
                    "enum": [
                        "supported",
                        "partially_supported",
                        "unsupported"
                    ]
                },
                "hops": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/frameworkHop"
                    }
                },
                "uncertainties": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    },
                    "uniqueItems": true
                },
                "evidence": {
                    "$ref": "#/$defs/evidenceReferences"
                }
            }
        },
        "frameworkHop": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "from_major",
                "to_major",
                "status",
                "rule_pack",
                "evidence"
            ],
            "properties": {
                "from_major": {
                    "type": "integer",
                    "minimum": 0
                },
                "to_major": {
                    "type": "integer",
                    "minimum": 0
                },
                "status": {
                    "enum": [
                        "supported",
                        "unsupported"
                    ]
                },
                "rule_pack": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "evidence": {
                    "$ref": "#/$defs/evidenceReferences"
                }
            }
        },
        "packageChange": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "change_type",
                "from_version",
                "to_version",
                "direct",
                "major_change",
                "package_families",
                "from_source_reference",
                "to_source_reference",
                "from_dist_reference",
                "to_dist_reference"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "change_type": {
                    "enum": [
                        "added",
                        "removed",
                        "upgraded",
                        "downgraded",
                        "changed"
                    ]
                },
                "from_version": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "to_version": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "direct": {
                    "type": "boolean"
                },
                "major_change": {
                    "type": "boolean"
                },
                "package_families": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    },
                    "uniqueItems": true
                },
                "from_source_reference": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "to_source_reference": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "from_dist_reference": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "to_dist_reference": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        },
        "rootConstraintChange": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "package",
                "change_type",
                "from_constraint",
                "to_constraint",
                "reason",
                "evidence"
            ],
            "properties": {
                "package": {
                    "type": "string",
                    "minLength": 1
                },
                "change_type": {
                    "enum": [
                        "added",
                        "updated",
                        "removed"
                    ]
                },
                "from_constraint": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "to_constraint": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "reason": {
                    "type": "string",
                    "minLength": 1
                },
                "evidence": {
                    "$ref": "#/$defs/evidenceReferences"
                }
            }
        },
        "blocker": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "subject",
                "requested_constraint",
                "blocker",
                "locked_version",
                "conflict",
                "dependency_path",
                "options",
                "summary",
                "confidence",
                "evidence"
            ],
            "properties": {
                "type": {
                    "type": "string",
                    "minLength": 1
                },
                "subject": {
                    "type": "string",
                    "minLength": 1
                },
                "requested_constraint": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "minLength": 1
                },
                "blocker": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "minLength": 1
                },
                "locked_version": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "minLength": 1
                },
                "conflict": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "minLength": 1
                },
                "dependency_path": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "options": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "summary": {
                    "type": "string",
                    "minLength": 1
                },
                "confidence": {
                    "$ref": "#/$defs/confidence"
                },
                "evidence": {
                    "$ref": "#/$defs/evidenceReferences"
                }
            }
        },
        "sourceUsage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "file",
                "symbol",
                "usage_type",
                "line",
                "evidence"
            ],
            "properties": {
                "file": {
                    "type": "string",
                    "minLength": 1
                },
                "symbol": {
                    "type": "string",
                    "minLength": 1
                },
                "usage_type": {
                    "type": "string",
                    "minLength": 1
                },
                "line": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "minimum": 1
                },
                "evidence": {
                    "$ref": "#/$defs/evidenceReferences"
                }
            }
        },
        "sourceImpactFinding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "affected_package",
                "ownership",
                "relevance",
                "reason",
                "severity",
                "occurrences",
                "evidence"
            ],
            "properties": {
                "affected_package": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "minLength": 1
                },
                "ownership": {
                    "enum": [
                        "exact",
                        "ambiguous",
                        "unknown"
                    ]
                },
                "relevance": {
                    "enum": [
                        "package_change",
                        "framework_rule",
                        "package_change_and_framework_rule"
                    ]
                },
                "reason": {
                    "type": "string",
                    "minLength": 1
                },
                "severity": {
                    "enum": [
                        "low",
                        "medium",
                        "high"
                    ]
                },
                "occurrences": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/sourceUsage"
                    }
                },
                "evidence": {
                    "$ref": "#/$defs/evidenceReferences"
                }
            }
        },
        "frameworkFinding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "framework",
                "severity",
                "summary",
                "applies_to_hops",
                "evidence"
            ],
            "properties": {
                "framework": {
                    "type": "string",
                    "minLength": 1
                },
                "severity": {
                    "enum": [
                        "low",
                        "medium",
                        "high"
                    ]
                },
                "summary": {
                    "type": "string",
                    "minLength": 1
                },
                "applies_to_hops": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/frameworkHopReference"
                    },
                    "uniqueItems": true
                },
                "evidence": {
                    "$ref": "#/$defs/evidenceReferences"
                }
            }
        },
        "frameworkHopReference": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "from_major",
                "to_major"
            ],
            "properties": {
                "from_major": {
                    "type": "integer",
                    "minimum": 0
                },
                "to_major": {
                    "type": "integer",
                    "minimum": 0
                }
            }
        },
        "plan": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "stages"
            ],
            "properties": {
                "stages": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/planStage"
                    }
                }
            }
        },
        "planStage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "summary",
                "actions",
                "evidence"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "summary": {
                    "type": "string",
                    "minLength": 1
                },
                "actions": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "evidence": {
                    "$ref": "#/$defs/evidenceReferences"
                }
            }
        },
        "risk": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "level",
                "drivers"
            ],
            "properties": {
                "level": {
                    "enum": [
                        "low",
                        "medium",
                        "high"
                    ]
                },
                "drivers": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        },
        "effort": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "range_hours",
                "confidence",
                "components",
                "assumptions"
            ],
            "properties": {
                "range_hours": {
                    "$ref": "#/$defs/hourRange"
                },
                "confidence": {
                    "$ref": "#/$defs/confidence"
                },
                "components": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/hourRange"
                    }
                },
                "assumptions": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        },
        "hourRange": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
                {
                    "type": "integer",
                    "minimum": 0
                },
                {
                    "type": "integer",
                    "minimum": 0
                }
            ],
            "items": false
        },
        "testGuidance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "purpose",
                "command",
                "priority"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "purpose": {
                    "type": "string",
                    "minLength": 1
                },
                "command": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "priority": {
                    "enum": [
                        "required",
                        "recommended"
                    ]
                }
            }
        },
        "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "class",
                "summary",
                "confidence",
                "context"
            ],
            "properties": {
                "id": {
                    "$ref": "#/$defs/evidenceId"
                },
                "class": {
                    "enum": [
                        "E1",
                        "E2",
                        "E3",
                        "E4",
                        "E5"
                    ]
                },
                "summary": {
                    "type": "string",
                    "minLength": 1
                },
                "confidence": {
                    "$ref": "#/$defs/confidence"
                },
                "context": {
                    "type": "object"
                }
            }
        },
        "evidenceReferences": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "$ref": "#/$defs/evidenceId"
            }
        },
        "evidenceId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "confidence": {
            "enum": [
                "low",
                "medium",
                "high"
            ]
        }
    }
}
