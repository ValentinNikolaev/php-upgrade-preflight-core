{
  "name": "php-upgrade-preflight/core",
  "description": "Deterministic Composer/PHP upgrade analysis core.",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.0",
    "composer/semver": "^3.4",
    "nikic/php-parser": "^4.19|^5.0",
    "symfony/filesystem": "^5.4|^6.0|^7.0",
    "symfony/finder": "^5.4|^6.0|^7.0",
    "symfony/process": "^5.4|^6.0|^7.0"
  },
  "autoload": {
    "psr-4": {
      "PhpUpgradePreflight\\Core\\": "src/"
    }
